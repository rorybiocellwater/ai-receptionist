# ── Email settings (Gmail) ──────────────────────────────────────────
# The Gmail address your AI receptionist sends FROM
EMAIL_FROM=youremail@gmail.com

# A Gmail App Password (NOT your normal Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The email address you want messages sent TO (can be the same as above)
EMAIL_TO=operator@yourbusiness.com

# ── Vapi settings ───────────────────────────────────────────────────
# Your Vapi API key from dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_api_key_here

# The Assistant ID you created in Vapi dashboard
VAPI_ASSISTANT_ID=your_assistant_id_here

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
